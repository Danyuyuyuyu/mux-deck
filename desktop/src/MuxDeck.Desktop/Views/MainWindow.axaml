<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MuxDeck.Desktop.ViewModels"
        xmlns:core="using:MuxDeck.Core"
        xmlns:views="using:MuxDeck.Desktop.Views"
        x:Class="MuxDeck.Desktop.Views.MainWindow" x:Name="WindowRoot" x:DataType="vm:MainWindowViewModel"
        Title="Mux Deck · 桌面版" Width="1280" Height="900" MinWidth="1040" MinHeight="760"
        Background="{DynamicResource WorkspaceBackground}" FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource FontBody}">
  <Window.Styles>
    <Style Selector="views|InteractionNotice">
      <Setter Property="Margin" Value="20,20,20,0" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="views|InteractionNotice.inspector">
      <Setter Property="Margin" Value="20,20,320,0" />
      <Setter Property="MaxWidth" Value="300" />
    </Style>
    <Style Selector="Grid.drop-overlay.blocked Rectangle.drop-outline">
      <Setter Property="Stroke" Value="{DynamicResource WarningText}" />
    </Style>
    <Style Selector="Rectangle.drop-outline">
      <Setter Property="Stroke" Value="{DynamicResource FocusBorder}" />
    </Style>
    <Style Selector="Grid.drop-overlay.blocked TextBlock.drop-icon">
      <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
    </Style>
    <Style Selector="TextBlock.drop-icon">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="172,*" RowDefinitions="*,24">
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,24,12,20">
        <StackPanel Spacing="6" Margin="10,0,0,24">
          <TextBlock Text="MUX DECK" FontSize="{DynamicResource FontBrand}" FontWeight="Bold" />
          <TextBlock Text="字幕封装工作区" Classes="muted" FontSize="{DynamicResource FontCaption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
          <Button Classes="nav" Classes.active="{Binding IsSingle}" Content="单个封装" Command="{Binding ShowSingleCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsBatch}" Content="批量队列 · 未实现" Command="{Binding ShowBatchCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsEnvironment}" Content="环境检测" Command="{Binding ShowEnvironmentCommand}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="6" Margin="10,0,0,0">
          <TextBlock Text="桌面版 · 单个封装" FontSize="{DynamicResource FontCaption}" />
          <TextBlock Text="ASS + 字体子集" Classes="muted" FontSize="{DynamicResource FontCaption}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="20,20,20,16" IsVisible="{Binding !IsSingle}">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <TextBlock Text="{Binding PageTitle}" FontSize="{DynamicResource FontPageTitle}" FontWeight="SemiBold" LineHeight="30" />
        <TextBlock Grid.Column="1" Text="{Binding PageDescription}" Classes="muted" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap" />
      </Grid>
      <Border Grid.Row="1" Classes="panel" IsVisible="{Binding IsBatch}" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Text="批量队列尚未实现" FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" />
          <TextBlock Text="当前可以在单个封装中处理一个视频和简繁 ASS。" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Classes="panel" IsVisible="{Binding IsSubtitle}" VerticalAlignment="Top">
        <TextBlock Text="字幕工具尚未实现" />
      </Border>
      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsEnvironment}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EnvironmentSummary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="重新检测" Command="{Binding RefreshEnvironmentCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ToolStatus">
                <Border Classes="panel" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" />
                    </Grid>
                    <TextBlock Text="{Binding Purpose}" Classes="muted" />
                    <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="{DynamicResource FontCaption}" Classes="muted" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="这里只检查工具路径；开始任务时验证实际工具与子集化后端。" Classes="muted" TextWrapping="Wrap" />
          <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="80" TextWrapping="Wrap" AutomationProperties.Name="环境日志" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackground}" Padding="12,5">
      <TextBlock Text="{Binding WorkspaceRoot}" FontSize="{DynamicResource FontCaption}" Classes="muted" TextTrimming="CharacterEllipsis" />
    </Border>
    <!-- 单任务视图拥有整块客户区，属性栏可贴右边并覆盖到底部路径条。 -->
    <views:SingleMuxView x:Name="SingleView" Grid.Column="1" Grid.RowSpan="2"
                         IsVisible="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).IsSingle}"
                         DataContext="{Binding Single}" />
    <views:InteractionNotice x:Name="InputNotice" Grid.Column="1" Grid.RowSpan="2"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Classes.inspector="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).Single.IsTrackInspectorOpen}" DataContext="{Binding Single.Notification}" />
    <!-- 纯展示遮罩覆盖导航和内容，实际接纳仍由窗口事件宿主判断，不截获指针。 -->
    <Grid x:Name="MediaDropOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding Single.DropFeedback.IsVisible}"
          Classes="drop-overlay" Classes.blocked="{Binding !Single.DropFeedback.CanAccept}" IsHitTestVisible="False" Background="{DynamicResource DropOverlayBackground}">
      <Rectangle Classes="drop-outline" Margin="10" StrokeThickness="1.5" StrokeDashArray="4,4" RadiusX="6" RadiusY="6" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource SoftBorder}" BorderThickness="1" CornerRadius="6" Padding="28,20" MaxWidth="620" Margin="24">
        <StackPanel Spacing="10">
          <TextBlock Classes="drop-icon" Text="{Binding Single.DropFeedback.Icon}" HorizontalAlignment="Center" FontSize="30" />
          <TextBlock Text="{Binding Single.DropFeedback.Title}" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Single.DropFeedback.Description}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

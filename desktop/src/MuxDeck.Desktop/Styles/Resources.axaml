<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 按用途命名，文字、选中背景和拖入反馈分别维护，避免互相牵连。 -->
  <Color x:Key="BrandAccentColor">#2563EB</Color>
  <SolidColorBrush x:Key="WorkspaceBackground" Color="#F5F7FA" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#EEF2F6" />
  <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PanelBorder" Color="#DCE3EC" />
  <SolidColorBrush x:Key="TableHeader" Color="#F1F4F8" />
  <SolidColorBrush x:Key="SoftBorder" Color="#D4DDE8" />
  <SolidColorBrush x:Key="TextPrimary" Color="#1E293B" />
  <SolidColorBrush x:Key="MutedText" Color="#526277" />
  <SolidColorBrush x:Key="DisabledText" Color="#718096" />
  <SolidColorBrush x:Key="DisabledBackground" Color="#E9EDF3" />
  <SolidColorBrush x:Key="PrimaryBackground" Color="{StaticResource BrandAccentColor}" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8" />
  <SolidColorBrush x:Key="PrimaryPressed" Color="#1E40AF" />
  <SolidColorBrush x:Key="OnPrimaryText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
  <SolidColorBrush x:Key="FocusBorder" Color="{StaticResource BrandAccentColor}" />
  <SolidColorBrush x:Key="HoverBackground" Color="#F1F5F9" />
  <SolidColorBrush x:Key="PressedBackground" Color="#E2E8F0" />
  <SolidColorBrush x:Key="ActiveNavigation" Color="#DBEAFE" />
  <SolidColorBrush x:Key="SelectedRowBackground" Color="#EFF6FF" />
  <SolidColorBrush x:Key="SelectionBorder" Color="{StaticResource BrandAccentColor}" />
  <SolidColorBrush x:Key="DropBackground" Color="#EFF6FF" />
  <SolidColorBrush x:Key="SuccessText" Color="#137547" />
  <SolidColorBrush x:Key="WarningText" Color="#925500" />
  <SolidColorBrush x:Key="DangerText" Color="#B42318" />
  <SolidColorBrush x:Key="DangerBorder" Color="#E9B7B2" />
  <SolidColorBrush x:Key="DangerBackground" Color="#FEF3F2" />
  <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ReadonlyBackground" Color="#F1F4F8" />
  <SolidColorBrush x:Key="InspectorBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InspectorBorder" Color="#CBD5E1" />
  <SolidColorBrush x:Key="InspectorDivider" Color="#E2E8F0" />

  <FontFamily x:Key="UiFontFamily">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="LogFontFamily">Consolas, Microsoft YaHei UI, monospace</FontFamily>
  <x:Double x:Key="FontCaption">12</x:Double>
  <x:Double x:Key="FontBody">13</x:Double>
  <x:Double x:Key="FontSection">14</x:Double>
  <x:Double x:Key="FontInspector">16</x:Double>
  <x:Double x:Key="FontCardTitle">18</x:Double>
  <x:Double x:Key="FontBrand">20</x:Double>
  <x:Double x:Key="FontPageTitle">22</x:Double>
  <CornerRadius x:Key="ControlRadius">4</CornerRadius>
  <CornerRadius x:Key="PanelRadius">6</CornerRadius>
  <Thickness x:Key="PanelPadding">12</Thickness>
  <Thickness x:Key="ControlPadding">10,5</Thickness>
  <Thickness x:Key="CompactControlPadding">8,4</Thickness>
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="CompactControlHeight">28</x:Double>
  <BoxShadows x:Key="TrackInspectorShadow">-6 0 20 0 #180F172A</BoxShadows>
  <BoxShadows x:Key="ResultInspectorShadow">0 -6 20 0 #180F172A</BoxShadows>
</ResourceDictionary>
